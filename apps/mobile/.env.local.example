# Copy to .env.local (git-ignored) to run the QA scripts and Maestro flows.

# Supabase dashboard → Project Settings → API Keys → secret / service_role key.
# Used only by scripts/qa-seed-users.mjs. Never put it in .env: that file is bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the QA test accounts (qa-*@example.com). Pick any value of 6+ characters;
# qa:seed sets it on the accounts and Maestro flows read it to log in.
QA_PASSWORD=
